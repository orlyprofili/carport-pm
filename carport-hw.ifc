#1447=IFCPROPERTYSINGLEVALUE('Notes',$,IFCTEXT('[{"id":"SWFACT-exit","text":"Exit: Versioned manufacturing images, RF test modes, locked test protocols, fixture automation/dashboard diagnostics, protected factory identity flow, authorized provisioning and serial/IMEI/SIM records; pass/fail output schema and calibration persistence. No private keys or credentials in build package/logs.","done":false}]'),$);

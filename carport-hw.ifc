#146=IFCTASKTIME('07 - Rev2 / T1 qualification in parallel with T2 tooling Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M76D','2026-11-02T09:00:00','2026-11-02T17:00:00','2027-03-01T09:00:00','2027-06-16T17:00:00','2027-03-25T09:00:00','2027-06-30T17:00:00','P0Y0M0D','P0Y0M10D',.F.,$,$,$,$,$,$);

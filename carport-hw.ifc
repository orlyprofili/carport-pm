#148=IFCTASKTIME('Confirm lab bookings, sample matrix and regulatory configuration Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2027-03-01T09:00:00','2027-03-05T17:00:00','2027-03-25T09:00:00','2027-04-01T17:00:00','P0Y0M0D','P0Y0M18D',.F.,$,$,$,$,$,$);
#149=IFCTASK('0z7kJCer7uFFKjbbL3IxaA',#6,'Confirm lab bookings, sample matrix and regulatory configuration','Quote/confirm staggered lab slots: Rev2 arrival/quick bring-up for electrical and conducted work, T1 molded samples for enclosure-sensitive work, and a T2 delta window. Document grant IDs, antennas, firmware/RF modes, cable/pack variants, representative sample agreement, test allocation and change policy. Schedule is not evidence a booking already exists.','USERDEFINED','7.1',$,$,$,.F.,$,#148,.USERDEFINED.);
#150=IFCTASKTIME('Accept representative T1 assemblies for formal lab work Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M2D','2026-11-02T09:00:00','2026-11-03T17:00:00','2027-04-16T09:00:00','2027-04-19T17:00:00','2027-05-03T09:00:00','2027-05-04T17:00:00','P0Y0M0D','P0Y0M11D',.F.,$,$,$,$,$,$);
#151=IFCTASK('3WAPytOqSstK8NLMC5fNOj',#6,'Accept representative T1 assemblies for formal lab work','Lab signs sample/configuration matrix: molded production-intent resin, antenna location/cables, fastening, pigtail/grill and ePTFE/adhesive stack with recorded dimensions/process. Hand-cut/applied parts can be accepted when they represent the intended controlled assembly method; printed materials do not establish molded enclosure qualification. Nonrepresentative items remain provisional and trigger affected T2 tests; no assumption that T1 is already equivalent.','USERDEFINED','7.2',$,$,$,.F.,$,#150,.USERDEFINED.);
#152=IFCTASKTIME('Rev2 vehicle power qualification - prototype housing allowed Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-03-30T09:00:00','2027-04-12T17:00:00','2027-05-27T09:00:00','2027-06-09T17:00:00','P0Y0M5D','P0Y0M41D',.F.,$,$,$,$,$,$);
#153=IFCTASK('3y1Nvj0LkRgpRnKJ5s_w$P',#6,'Rev2 vehicle power qualification - prototype housing allowed','Run signed ISO 7637-2 / ISO 16750-2 electrical tests as scoped, reverse battery, crank, jump start, load dump, hot plug, shorts and USB/source combinations on traceable Rev2 with representative harness/pack/load and firmware. Printed housing is acceptable only where the lab records that enclosure/thermal/mounting effects cannot invalidate results. Board/port ESD may start; final accessible-assembly ESD is a separate T1 task. Verify recovery/leakage; no blanket automotive-certified claim.','USERDEFINED','7.3',$,$,$,.F.,$,#152,.USERDEFINED.);
#154=IFCTASKTIME('T1 accessible-assembly ESD and enclosed thermal confirmation Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2027-04-20T09:00:00','2027-04-26T17:00:00','2027-06-10T09:00:00','2027-06-16T17:00:00','P0Y0M26D','P0Y0M36D',.F.,$,$,$,$,$,$);
#155=IFCTASK('3a9yHqqdc6pKcwMcRA7Tvs',#6,'T1 accessible-assembly ESD and enclosed thermal confirmation','Complete enclosure-dependent accessible-point ESD, USB/pigtail/button/seam discharge paths and worst-case enclosed thermal/radio-load checks on representative T1. Cross-reference early Rev2 power results; repeat affected tests where T1 grounding, mounting, heat flow or wiring differs. Final T2 changes require delta review.','USERDEFINED','7.4',$,$,$,.F.,$,#154,.USERDEFINED.);
#156=IFCTASKTIME('T1 enclosure, environmental and cable qualification Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T09:00:00','2026-11-27T17:00:00','2027-04-20T09:00:00','2027-05-17T17:00:00','2027-05-19T09:00:00','2027-06-16T17:00:00','P0Y0M11D','P0Y0M21D',.F.,$,$,$,$,$,$);
#157=IFCTASK('0KaTKPL7vYbGl3p72sJXX2',#6,'T1 enclosure, environmental and cable qualification','Run approved environmental/cable/membrane DVP&R on lab-accepted production-intent molded T1 assemblies: temperature/humidity/condensation/cycles, vibration/shock/drop, ingress target, scoped fluid/UV, pull/flex and connector/button life. Measure acoustic/RH response and bonding/grill performance before/after. Record controlled hand-assembly method where representative; substitute material or process results are provisional. T2 delta review determines repeats; long-duration aging adds explicit time.','USERDEFINED','7.5',$,$,$,.F.,$,#156,.USERDEFINED.);
#158=IFCTASKTIME('T1 US FCC / Canada ISED host RF, emissions and exposure assessment Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M30D','2026-11-02T09:00:00','2026-12-11T17:00:00','2027-04-20T09:00:00','2027-06-01T17:00:00','2027-05-05T09:00:00','2027-06-16T17:00:00','P0Y0M0D','P0Y0M11D',.F.,$,$,$,$,$,$);
#159=IFCTASK('2JUucmKYcVCrkosTDq5b4X',#6,'T1 US FCC / Canada ISED host RF, emissions and exposure assessment','Test/assess lab-accepted representative Rev2/T1 configuration against applicable rules and module grant restrictions, antenna gains/bands, simultaneous transmit modes, RF exposure and host emissions. Formal radiated results require representative mechanics; printed parts alone do not establish final conformity. Obtain reports/filing-route conclusion; final applicability to T2 is decided at explicit delta gate.','USERDEFINED','7.6',$,$,$,.F.,$,#158,.USERDEFINED.);
#160=IFCTASKTIME('Rev2 cellular/operator and conditional NTN conducted / protocol campaign Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T09:00:00','2026-11-27T17:00:00','2027-03-30T09:00:00','2027-04-26T17:00:00','2027-05-05T09:00:00','2027-06-02T17:00:00','P0Y0M0D','P0Y0M26D',.F.,$,$,$,$,$,$);
#161=IFCTASK('1CreohVflzWiL4qv1$GRls',#6,'Rev2 cellular/operator and conditional NTN conducted / protocol campaign','Begin applicable PTCRB/IoT/operator route on verified Rev2 and selected module/modem/NCS/SIM/provider: conducted RF, network/protocol, provisioning and SIM lifecycle work that does not require final enclosure. Printed housing may support bench work with lab agreement. OTA/antenna-dependent acceptance follows on T1; include conditional NTN service tests or documented disabled feature scope.','USERDEFINED','7.7',$,$,$,.F.,$,#160,.USERDEFINED.);
#162=IFCTASKTIME('T1 cellular OTA / antenna and provider acceptance completion Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-04-27T09:00:00','2027-05-10T17:00:00','2027-06-03T09:00:00','2027-06-16T17:00:00','P0Y0M15D','P0Y0M26D',.F.,$,$,$,$,$,$);
#163=IFCTASK('3JwQkOsu6m_ltpofBgC$g_',#6,'T1 cellular OTA / antenna and provider acceptance completion','Complete required antenna/OTA and selected-carrier/provider acceptance on representative Rev2/T1 assembly, incorporating early conducted/protocol results. NTN approval evidence is included if selected. Record exact accepted hardware/firmware/antenna configuration; T2 changes are checked at the delta gate.','USERDEFINED','7.8',$,$,$,.F.,$,#162,.USERDEFINED.);
#164=IFCTASKTIME('Complete Bluetooth product qualification Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-03-30T09:00:00','2027-04-12T17:00:00','2027-06-03T09:00:00','2027-06-16T17:00:00','P0Y0M35D','P0Y0M46D',.F.,$,$,$,$,$,$);
#165=IFCTASK('3$jVmf0ciQnPYNKD$MN7IO',#6,'Complete Bluetooth product qualification','Company membership, qualified-design reuse/testing route, product identity and submission complete; retain product qualification record before market distribution.','USERDEFINED','7.9',$,$,$,.F.,$,#164,.USERDEFINED.);
#166=IFCTASKTIME('Battery, transport, material and product safety documentation Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M15D','2026-11-02T09:00:00','2026-11-20T17:00:00','2027-03-08T09:00:00','2027-03-29T17:00:00','2027-05-27T09:00:00','2027-06-16T17:00:00','P0Y0M45D','P0Y0M56D',.F.,$,$,$,$,$,$);
#167=IFCTASK('1Vogf9yxhv8ps4sQG890mo',#6,'Battery, transport, material and product safety documentation','Confirm actual cell/pack chemistry/configuration and applicable safety evaluation, protection/charging temperature behavior; UN 38.3 test summary for shipped lithium configuration and packaging requirements where applicable, supplier safety files, resin flammability and material declarations. New/modified pack testing requires a separate quoted loop; module approvals do not cover this.','USERDEFINED','7.10',$,$,$,.F.,$,#166,.USERDEFINED.);
#168=IFCTASKTIME('Preliminary T2 qualification change-impact review Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M3D','2026-11-02T09:00:00','2026-11-04T17:00:00','2027-05-19T09:00:00','2027-05-21T17:00:00','2027-06-14T09:00:00','2027-06-16T17:00:00','P0Y0M7D','P0Y0M17D',.F.,$,$,$,$,$,$);
#169=IFCTASK('0rVYcxAHmpT230Vom8$yjp',#6,'Preliminary T2 qualification change-impact review','Compare incoming T2 configuration with tested Rev2/T1 and identify likely affected reports, tests and filings while T2 evaluation and lab campaigns continue. This is preliminary: lab/quality final carry-forward approval awaits T2 acceptance and completed initial campaigns in the final disposition and retest task.','USERDEFINED','7.11',$,$,$,.F.,$,#168,.USERDEFINED.);
#170=IFCTASKTIME('Prepare labels, installation instructions and compliance file Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-06-02T09:00:00','2027-06-15T17:00:00','2027-06-17T09:00:00','2027-06-30T17:00:00','P0Y0M1D','P0Y0M11D',.F.,$,$,$,$,$,$);
#171=IFCTASK('3rlcCq4Yp7FcpNPfjEbCdv',#6,'Prepare labels, installation instructions and compliance file','Prepare applicable US/Canada IDs/labels and Canadian bilingual notices as required, antenna/install separation, approved operating environment/power/accessories and provider scope. Reference Rev2/T1 reports and update to final T2 after delta/retest; final document approval occurs at G6. Expansion markets require fresh assessment.','USERDEFINED','7.12',$,$,$,.F.,$,#170,.USERDEFINED.);
#172=IFCTASKTIME('Final T2 qualification disposition and affected retest reserve Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-06-03T09:00:00','2027-06-16T17:00:00','2027-06-17T09:00:00','2027-06-30T17:00:00','P0Y0M0D','P0Y0M10D',.F.,$,$,$,$,$,$);
#173=IFCTASK('34QMJMWExSqtYiKlTiWMGv',#6,'Final T2 qualification disposition and affected retest reserve','After T2 acceptance, preliminary impact review and all initial campaigns, lab and quality approve final carry-forward or identify and complete affected tests, filings and operator acceptances. Reserve 10 working days for final disposition, one minor retest cycle and report/document updates. Major changes require a longer explicit loop; release remains blocked until the final configuration is covered.','USERDEFINED','7.13',$,$,$,.F.,$,#172,.USERDEFINED.);
#174=IFCTASKTIME('G6 - Qualification and US/Canada release evidence accepted Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2027-06-16T17:00:00','2027-06-16T17:00:00','2027-06-30T17:00:00','2027-06-30T17:00:00','P0Y0M10D','P0Y0M10D',.F.,$,$,$,$,$,$);
#175=IFCTASK('3bV0KscPvmRXnN2KiZynm7',#6,'G6 - Qualification and US/Canada release evidence accepted','Signed qualification reports and required authorizations/acceptances cover the exact final T2 sale configuration. T2 delta disposition and affected retests closed, final labels/manuals approved, and NTN inclusion/deferment explicit before customer distribution. Earlier Rev2/T1 results are carried forward only with documented lab/quality agreement.','USERDEFINED','7.14',$,$,$,.T.,$,#174,.USERDEFINED.);
#176=IFCTASKTIME('08 - Manufacturing system and software handoff gates Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M86D','2026-11-02T09:00:00','2026-11-02T17:00:00','2027-03-01T09:00:00','2027-06-30T17:00:00','2027-05-05T09:00:00','2027-06-30T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#177=IFCTASK('0aRLnnM7adaSGyCx6cRgg3',#6,'08 - Manufacturing system and software handoff gates',$,'USERDEFINED','8',$,$,$,.F.,$,#176,.USERDEFINED.);
#178=IFCTASKTIME('Design production programming and end-of-line fixtures Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-03-01T09:00:00','2027-03-12T17:00:00','2027-05-05T09:00:00','2027-05-18T17:00:00','P0Y0M5D','P0Y0M46D',.F.,$,$,$,$,$,$);
#179=IFCTASK('0pw2LN5KPPxfh0YTo6MZvW',#6,'Design production programming and end-of-line fixtures','Fixture design covers protected power, contact access, ESP32 USB/UART and nRF SWD/modem programming, serial/MAC/IMEI/SIM association, rail/current tests, radio/GNSS checks, sensor/mic/RH, buttons/RGB and leak/vent tests where appropriate. Throughput and calibration/reference strategy defined.','USERDEFINED','8.1',$,$,$,.F.,$,#178,.USERDEFINED.);
#180=IFCTASKTIME('Build and correlate fixtures with golden/reference units Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M15D','2026-11-02T07:00:00','2026-11-20T07:00:00','2027-04-09T07:00:00','2027-04-29T07:00:00','2027-05-27T07:00:00','2027-06-16T07:00:00','P0Y0M23D','P0Y0M31D',.F.,$,$,$,$,$,$);
#181=IFCTASK('0Biv8RGPR6MRLBE69ExVxi',#6,'Build and correlate fixtures with golden/reference units','Fixtures delivered, limits derived from qualification, reference/failing-unit studies demonstrate detection, gauge repeatability assessed and station/firmware logs retained. Destructive qualification and end-of-line screens have distinct coverage.','USERDEFINED','8.2',$,$,$,.F.,$,#180,.USERDEFINED.);
#182=IFCTASKTIME('External gate - Factory firmware, provisioning and test tools Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T09:00:00','2026-11-27T17:00:00','2027-03-22T09:00:00','2027-04-19T17:00:00','2027-05-19T09:00:00','2027-06-16T17:00:00','P0Y0M31D','P0Y0M41D',.F.,$,$,$,$,$,$);
#183=IFCTASK('066NU22NHaDloUTlEBQuTM',#6,'External gate - Factory firmware, provisioning and test tools','Versioned manufacturing images, RF test modes, locked test protocols, fixture automation/dashboard diagnostics, protected factory identity flow, authorized provisioning and serial/IMEI/SIM records; pass/fail output schema and calibration persistence. No private keys or credentials in build package/logs.','USERDEFINED','8.3',$,$,$,.F.,$,#182,.USERDEFINED.);
#184=IFCTASKTIME('External gate - Integrated product release candidate Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M30D','2026-11-02T09:00:00','2026-12-11T17:00:00','2027-03-22T09:00:00','2027-05-03T17:00:00','2027-05-19T09:00:00','2027-06-30T17:00:00','P0Y0M41D','P0Y0M41D',.F.,$,$,$,$,$,$);
#185=IFCTASK('2dMtITNAHb53v7f32UHF3O',#6,'External gate - Integrated product release candidate','Versioned ESP32/nRF/shared/protobuf, mobile tools/onboarding/OTA, dashboard and AWS contracts pass cross-repo integration: cellular/Wi-Fi/BLE paths, location, recording/relay, secure ownership, updates, factory reset/calibration retention, recovery and low power. Feature maturity is not inferred from README. Separate software project manages scope and iterations.','USERDEFINED','8.4',$,$,$,.F.,$,#184,.USERDEFINED.);
#186=IFCTASKTIME('Create assembly SOPs, quality control and training package Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-06-03T09:00:00','2027-06-16T17:00:00','2027-06-17T09:00:00','2027-06-30T17:00:00','P0Y0M10D','P0Y0M10D',.F.,$,$,$,$,$,$);
#187=IFCTASK('1Q6rrmbPgz4q7KX$NN8ZcK',#6,'Create assembly SOPs, quality control and training package','Work instructions for membrane cleanliness/bond/cure, grill/screen retention, torque, seals/pigtail/USB, ESD/rework and traceability; incoming/supplier quality, PFMEA/control plan, calibration, first-article approval and operator training. Golden unit and tooling/fixture backups retained.','USERDEFINED','8.5',$,$,$,.F.,$,#186,.USERDEFINED.);
#188=IFCTASKTIME('Approve production material availability and logistics plan Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T07:00:00','2026-11-27T07:00:00','2027-06-03T07:00:00','2027-06-30T07:00:00','2027-06-03T07:00:00','2027-06-30T07:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#189=IFCTASK('19hx4gvkWP90sfYqZ9J4L0',#6,'Approve production material availability and logistics plan','Approved AVL, alternatives via ECO, allocation and forecast for radios/SIMs/antenna/resin/ePTFE/adhesive/cable/battery; no speculative full MP purchase. Pilot materials authorized; freight/customs/battery transport plan and supplier change notifications defined.','USERDEFINED','8.6',$,$,$,.F.,$,#188,.USERDEFINED.);
#190=IFCTASKTIME('G7 - Controlled pilot build readiness Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2027-06-30T17:00:00','2027-06-30T17:00:00','2027-06-30T17:00:00','2027-06-30T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#191=IFCTASK('3CCC9oLiwgyOWWb6NKCiQC',#6,'G7 - Controlled pilot build readiness','Released exact hardware/firmware/BOM/work instructions, calibrated validated test stations, material, required compliance evidence and trained operators. Approve proposed PVT lot and quality targets before build.','USERDEFINED','8.7',$,$,$,.T.,$,#190,.USERDEFINED.);
#192=IFCTASKTIME('09 - Pilot, production release and ramp Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M56D','2026-11-02T09:00:00','2026-11-02T17:00:00','2027-07-01T09:00:00','2027-09-21T17:00:00','2027-07-01T09:00:00','2027-09-21T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#193=IFCTASK('1rYzP4RMdycajI7lxBdOjc',#6,'09 - Pilot, production release and ramp',$,'USERDEFINED','9',$,$,$,.F.,$,#192,.USERDEFINED.);
#194=IFCTASKTIME('Run PVT pilot on intended overseas production line Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T07:00:00','2026-11-13T07:00:00','2027-07-01T07:00:00','2027-07-14T07:00:00','2027-07-01T07:00:00','2027-07-14T07:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#195=IFCTASK('0a_YLxAZmil8cY087jolm5',#6,'Run PVT pilot on intended overseas production line','Suggested 100-unit lot uses intended staff, tools, resin/process and end-of-line tests. Record first-pass yield, defects/rework, cycle time, cavity/lot/serial traceability and process capability where sample size supports it; retain golden/reference units.','USERDEFINED','9.1',$,$,$,.F.,$,#194,.USERDEFINED.);
#196=IFCTASKTIME('Ship pilot units and verify receiving / fulfillment process Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T07:00:00','2026-11-06T07:00:00','2027-07-15T07:00:00','2027-07-19T07:00:00','2027-07-15T07:00:00','2027-07-19T07:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#197=IFCTASK('0h8sRmIE6_LC$i3F1jb90A',#6,'Ship pilot units and verify receiving / fulfillment process','Pilot import, packaging, handling and shipment records verified; random receiving audit matches station records and serial/SIM identities.','USERDEFINED','9.2',$,$,$,.F.,$,#196,.USERDEFINED.);
#198=IFCTASKTIME('Supervised US/Canada vehicle pilot and soak Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M15D','2026-11-02T09:00:00','2026-11-20T17:00:00','2027-07-20T09:00:00','2027-08-10T17:00:00','2027-07-20T09:00:00','2027-08-10T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#199=IFCTASK('1ZKk9CZWDvc2EZRNgSP5o5',#6,'Supervised US/Canada vehicle pilot and soak','Representative vehicles/installations and routes exercise cellular/GNSS/Wi-Fi/BLE, power/crank/sleep, heat/condensation, onboarding/OTA/recovery and optional approved NTN; retain logs with consent. Three weeks is a discovery pilot, not lifetime reliability proof.','USERDEFINED','9.3',$,$,$,.F.,$,#198,.USERDEFINED.);
#200=IFCTASKTIME('Close pilot defects and approve yield / quality evidence Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2027-08-11T09:00:00','2027-08-17T17:00:00','2027-08-11T09:00:00','2027-08-17T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#201=IFCTASK('0ak1lP19enN$FDs2q0FbMH',#6,'Close pilot defects and approve yield / quality evidence','Critical/major issues closed with retest and ECO impact assessment; baseline proposed targets >=95% first-pass yield, 100% functional screen pass before ship and zero unresolved critical defects require owner approval. Verify RMA/repair/OTA support and traceability.','USERDEFINED','9.4',$,$,$,.F.,$,#200,.USERDEFINED.);
#202=IFCTASKTIME('G8 - Authorize mass production release Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2027-08-17T17:00:00','2027-08-17T17:00:00','2027-08-17T17:00:00','2027-08-17T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#203=IFCTASK('1Kt53G1c08aD_5ygcN076$',#6,'G8 - Authorize mass production release','Operator approves production quantity/PO against demand, cash, capacity and accepted quality. Qualified configuration and golden sample locked; change control, stop-ship and field monitoring owners assigned.','USERDEFINED','9.5',$,$,$,.T.,$,#202,.USERDEFINED.);
#204=IFCTASKTIME('Build first mass-production lot and controlled ramp Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T07:00:00','2026-11-27T07:00:00','2027-08-18T07:00:00','2027-09-14T07:00:00','2027-08-18T07:00:00','2027-09-14T07:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#205=IFCTASK('2INvHvGk3nxrgVKbXXjuOR',#6,'Build first mass-production lot and controlled ramp','Size of first MP lot set at G8; control plan, sampling/audit, complete serialized test records, yield monitoring and supplier capacity demonstrated; hold nonconforming units.','USERDEFINED','9.6',$,$,$,.F.,$,#204,.USERDEFINED.);

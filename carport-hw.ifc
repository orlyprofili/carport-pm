#80=IFCTASKTIME('External gate - Rev1 bring-up firmware and diagnostic tools Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M7D','2026-11-02T09:00:00','2026-11-20T17:00:00','2026-11-11T09:00:00','2026-11-19T17:00:00','2026-12-21T09:00:00','2027-01-07T17:00:00','P0Y0M21D','P0Y0M28D',.F.,$,$,$,$,$,$);
#81=IFCTASK('2JNcCQ7M3FiUyOyQfXXGQ8',#6,'External gate - Rev1 bring-up firmware and diagnostic tools','Versioned Rev1 pin map, flash/storage change, sensor addressing, charger source policy, USB-only latch-off recovery, rail sequencing/back-power prevention, fuel-gauge configuration and diagnostic capture ready. Dashboard/carportpy/proto compatible. Deliverables managed in software backlogs.','USERDEFINED','3.3',$,$,$,.F.,$,#80,.USERDEFINED.);
#82=IFCTASKTIME('Bring up Rev1 PCBA with current-limited staged power Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2026-12-21T09:00:00','2027-01-05T17:00:00','2027-01-08T09:00:00','2027-01-14T17:00:00','P0Y0M0D','P0Y0M7D',.F.,$,$,$,$,$,$);
#83=IFCTASK('2Ciu76akN1SnETtA4GZQwo',#6,'Bring up Rev1 PCBA with current-limited staged power','Supply currents/rails verified before radios; USB enumeration, debug recovery, sensor/mic/button/RGB, flash, reset/boot and UART tested. Record boot firmware, serial and measurement setup.','USERDEFINED','3.4',$,$,$,.F.,$,#82,.USERDEFINED.);
#84=IFCTASKTIME('Rev1 power, input fault screening and radio transient tests Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-01-06T09:00:00','2027-01-19T17:00:00','2027-01-15T09:00:00','2027-01-28T17:00:00','P0Y0M0D','P0Y0M7D',.F.,$,$,$,$,$,$);
#85=IFCTASK('3oWQwSFX8ewOID7N5R92XF',#6,'Rev1 power, input fault screening and radio transient tests','Measure reverse/positive stress within declared envelope, brownout and crank recovery, USB-only/battery absent/depleted modes, charge/source limits after reset, 3.2 V radio droop, thermal/efficiency and sleep draw; no unresolved unsafe stress. Destructive tests use allocated units.','USERDEFINED','3.5',$,$,$,.F.,$,#84,.USERDEFINED.);

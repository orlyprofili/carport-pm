#59=IFCTASK('1ET7Fvd0fh9Qo7ZPgj8Pqc',#6,'Close Rev1 schematic review and BOM metadata','Resolve reviewer comments and R2-03 MPN/tolerance/voltage/dielectric metadata; regenerate correct dev/production variants, BOM and netlist; run Altium compiler/ERC; unresolved risks have written containment. Saved source, reviewed PDF and exports agree.','USERDEFINED','2.1',$,$,$,.F.,$,#58,.USERDEFINED.);
#60=IFCTASKTIME('Bound Rev1 input fault stresses before destructive testing Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-09T09:00:00','2026-11-20T17:00:00','2026-11-11T09:00:00','2026-11-24T17:00:00','P0Y0M0D','P0Y0M2D',.F.,$,$,$,$,$,$);
#61=IFCTASK('0Gh09apWxDTX2c9_BaEeSC',#6,'Bound Rev1 input fault stresses before destructive testing','Declare reverse battery, jump start, crank, pulse/load dump and USB overlap envelopes. Close R2-04 reverse comparator-pin injection allowance and transient peak/terminal stresses, or implement safe changes/bench containment. Static simulation alone is not fault qualification.','USERDEFINED','2.2',$,$,$,.F.,$,#60,.USERDEFINED.);
#62=IFCTASKTIME('Complete Rev1 routing and RF / power / mechanical review Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-23T09:00:00','2026-12-04T17:00:00','2026-11-25T09:00:00','2026-12-08T17:00:00','P0Y0M0D','P0Y0M2D',.F.,$,$,$,$,$,$);
#63=IFCTASK('3VSaG5SR4m5nC0h9Q6u4lO',#6,'Complete Rev1 routing and RF / power / mechanical review','Layout review checks switcher hot loops, return paths, antenna keep-outs/feed/matching, GNSS isolation, debug/test access, thermal copper, USB, pigtail, button/LED alignment, board outline and tolerances. DRC and 3D clearance review pass.','USERDEFINED','2.3',$,$,$,.F.,$,#62,.USERDEFINED.);
#64=IFCTASKTIME('Rev1 PCBA DFM, AVL availability and release package Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2026-12-07T09:00:00','2026-12-11T17:00:00','2026-12-09T09:00:00','2026-12-15T17:00:00','P0Y0M0D','P0Y0M2D',.F.,$,$,$,$,$,$);
#65=IFCTASK('2G4BT4k6BOF1JRZS9FvH4k',#6,'Rev1 PCBA DFM, AVL availability and release package','CM acknowledges controlled fabrication/assembly package, stackup, impedance, stencil, polarity, firmware/debug access, approved substitutions, DNP variants and long-lead material status. Do not treat old exports as current production files.','USERDEFINED','2.4',$,$,$,.F.,$,#64,.USERDEFINED.);
#66=IFCTASKTIME('G1 - Release Rev1 PCBA prototype run Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2026-12-11T17:00:00','2026-12-11T17:00:00','2026-12-15T17:00:00','2026-12-15T17:00:00','P0Y0M0D','P0Y0M2D',.F.,$,$,$,$,$,$);
#67=IFCTASK('25SjEenJUbMEzuG4rbZs98',#6,'G1 - Release Rev1 PCBA prototype run','Signed Rev1 build release; quote and proposed lot approved; Rev1 is an engineering prototype with fault-test restrictions documented.','USERDEFINED','2.5',$,$,$,.T.,$,#66,.USERDEFINED.);
#68=IFCTASKTIME('Design clamshell and interfaces for prototype manufacture Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-09T09:00:00','2026-11-20T17:00:00','2026-12-04T09:00:00','2026-12-17T17:00:00','P0Y0M0D','P0Y0M19D',.F.,$,$,$,$,$,$);
#69=IFCTASK('2KLhtHivBcnqM76VTVhbLZ',#6,'Design clamshell and interfaces for prototype manufacture','Two plastic shell halves; fastening/seal strategy, wall/rib/draft and tool parting concept. USB access/sealing, power pigtail strain-relief and pull load path, user button/RGB light path, ESP32 reset/boot and nRF reset access, mounting and antenna clearances are defined.','USERDEFINED','2.6',$,$,$,.F.,$,#68,.USERDEFINED.);
#70=IFCTASKTIME('Select humidity vent and MEMS acoustic membrane stacks Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-09T09:00:00','2026-11-20T17:00:00','2026-12-04T09:00:00','2026-12-17T17:00:00','P0Y0M0D','P0Y0M19D',.F.,$,$,$,$,$,$);
#71=IFCTASK('3qM1axEe6w2ahPHspuyGFg',#6,'Select humidity vent and MEMS acoustic membrane stacks','Evaluate ePTFE humidity exchange and acoustic vent separately: RH response, mic insertion loss/bandwidth, cavity geometry, adhesives, supported bond land, contamination/condensation, grill/screen protection and material compatibility. Sharing a port requires evidence; vent rating is not whole-product IP certification.','USERDEFINED','2.7',$,$,$,.F.,$,#70,.USERDEFINED.);
#72=IFCTASKTIME('Print housing variants and hand-build membrane/grill/pigtail prototypes Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-23T09:00:00','2026-12-04T17:00:00','2026-12-18T09:00:00','2027-01-11T17:00:00','P0Y0M0D','P0Y0M19D',.F.,$,$,$,$,$,$);
#73=IFCTASK('3kPtlg70o_aSbhFYy43UqC',#6,'Print housing variants and hand-build membrane/grill/pigtail prototypes','Printed shell fits and hand-applied ePTFE, screen/grill, light pipe, seals and strain relief available; build record captures orientation/material/adhesive/cure. Include vent-only coupons and cable pull fixtures.','USERDEFINED','2.8',$,$,$,.F.,$,#72,.USERDEFINED.);
#74=IFCTASKTIME('Evaluate printed enclosure fit, acoustic/RH and cable interfaces Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2026-12-07T09:00:00','2026-12-11T17:00:00','2027-01-12T09:00:00','2027-01-18T17:00:00','P0Y0M18D','P0Y0M19D',.F.,$,$,$,$,$,$);
#75=IFCTASK('2e1PZYpt3XynYa705N6acf',#6,'Evaluate printed enclosure fit, acoustic/RH and cable interfaces','Fit real board or verified dimensional surrogate; test button/LED/dev access, USB insertion, pigtail pull/bend, grille damage, mic response/RH lag and condensation. Printed/handmade performance is screening evidence, not molded-process qualification.','USERDEFINED','2.9',$,$,$,.F.,$,#74,.USERDEFINED.);

#77=IFCTASK('2EQYzE56f8KmDfzcvRhSJ3',#6,'Fabricate and assemble Rev1 engineering boards','CM assembly report, AOI/X-ray where appropriate, component traceability, serial numbers and approved substitutions; staged release of first boards if feasible.','USERDEFINED','3.1',$,$,$,.F.,$,#76,.USERDEFINED.);

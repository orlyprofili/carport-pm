#64=IFCTASKTIME('G1 - Release Rev1 PCBA prototype run Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2026-12-01T17:00:00','2026-12-01T17:00:00','2026-12-17T17:00:00','2026-12-17T17:00:00','P0Y0M0D','P0Y0M12D',.F.,$,$,$,$,$,$);
#65=IFCTASK('33E4uSRN1$$641hoXqMkNC',#6,'G1 - Release Rev1 PCBA prototype run','Signed Rev1 build release; quote and proposed lot approved; Rev1 is an engineering prototype with fault-test restrictions documented.','USERDEFINED','2.4',$,$,$,.T.,$,#64,.USERDEFINED.);
#66=IFCTASKTIME('Design clamshell and interfaces for prototype manufacture Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-09T09:00:00','2026-11-20T17:00:00','2026-12-02T09:00:00','2026-12-15T17:00:00','P0Y0M0D','P0Y0M17D',.F.,$,$,$,$,$,$);
#67=IFCTASK('3w_2WfKqTi2bze9n97zQSV',#6,'Design clamshell and interfaces for prototype manufacture','Two plastic shell halves; fastening/seal strategy, wall/rib/draft and tool parting concept. USB access/sealing, power pigtail strain-relief and pull load path, user button/RGB light path, ESP32 reset/boot and nRF reset access, mounting and antenna clearances are defined.','USERDEFINED','2.5',$,$,$,.F.,$,#66,.USERDEFINED.);
#68=IFCTASKTIME('Select humidity vent and MEMS acoustic membrane stacks Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-09T09:00:00','2026-11-20T17:00:00','2026-12-02T09:00:00','2026-12-15T17:00:00','P0Y0M0D','P0Y0M17D',.F.,$,$,$,$,$,$);
#69=IFCTASK('0rznS3BI45iwqmGXSmQdJ8',#6,'Select humidity vent and MEMS acoustic membrane stacks','Evaluate ePTFE humidity exchange and acoustic vent separately: RH response, mic insertion loss/bandwidth, cavity geometry, adhesives, supported bond land, contamination/condensation, grill/screen protection and material compatibility. Sharing a port requires evidence; vent rating is not whole-product IP certification.','USERDEFINED','2.6',$,$,$,.F.,$,#68,.USERDEFINED.);
#70=IFCTASKTIME('Print housing variants and hand-build membrane/grill/pigtail prototypes Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-23T09:00:00','2026-12-04T17:00:00','2026-12-16T09:00:00','2027-01-07T17:00:00','P0Y0M0D','P0Y0M17D',.F.,$,$,$,$,$,$);
#71=IFCTASK('0ah_UWEyBctKTLdvlq6Fhx',#6,'Print housing variants and hand-build membrane/grill/pigtail prototypes','Printed shell fits and hand-applied ePTFE, screen/grill, light pipe, seals and strain relief available; build record captures orientation/material/adhesive/cure. Include vent-only coupons and cable pull fixtures.','USERDEFINED','2.7',$,$,$,.F.,$,#70,.USERDEFINED.);
#72=IFCTASKTIME('Evaluate printed enclosure fit, acoustic/RH and cable interfaces Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2026-12-07T09:00:00','2026-12-11T17:00:00','2027-01-08T09:00:00','2027-01-14T17:00:00','P0Y0M10D','P0Y0M17D',.F.,$,$,$,$,$,$);
#73=IFCTASK('3yFTU5mIiZ2gxL5uoSorxY',#6,'Evaluate printed enclosure fit, acoustic/RH and cable interfaces','Fit real board or verified dimensional surrogate; test button/LED/dev access, USB insertion, pigtail pull/bend, grille damage, mic response/RH lag and condensation. Printed/handmade performance is screening evidence, not molded-process qualification.','USERDEFINED','2.8',$,$,$,.F.,$,#72,.USERDEFINED.);

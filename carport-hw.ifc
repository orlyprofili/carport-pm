#149=IFCTASK('0WeVVYbVOniQ$sj4oNGlnO',#6,'Confirm lab bookings, sample matrix and regulatory configuration','Lab slots quoted/confirmed for forecast T2 availability with change policy; exact grant IDs, antennas, firmware/RF modes, accessory/cable variants and sample count documented. Schedule is not evidence a booking already exists.','USERDEFINED','7.1',$,$,$,.F.,$,#148,.USERDEFINED.);
#150=IFCTASKTIME('Formal vehicle electrical / ESD qualification Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-06-14T09:00:00','2027-06-25T17:00:00','2027-07-13T09:00:00','2027-07-26T17:00:00','P0Y0M20D','P0Y0M20D',.F.,$,$,$,$,$,$);
#151=IFCTASK('3jUxz51kZ7oiM$yJO6_xDG',#6,'Formal vehicle electrical / ESD qualification','Execute signed installation-specific DVP&R: ISO 7637-2 transient and ISO 16750-2 electrical load categories as applicable, reverse battery, crank, jump start, load dump, hot plug, shorts, USB/source combinations and ESD (ISO 10605/IEC 61000-4-2 as scoped). Verify function/recovery and post-test leakage. No blanket automotive-certified claim.','USERDEFINED','7.2',$,$,$,.F.,$,#150,.USERDEFINED.);
#152=IFCTASKTIME('Formal enclosure, environmental and cable qualification Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T09:00:00','2026-11-27T17:00:00','2027-06-14T09:00:00','2027-07-12T17:00:00','2027-06-28T09:00:00','2027-07-26T17:00:00','P0Y0M10D','P0Y0M10D',.F.,$,$,$,$,$,$);
#153=IFCTASK('3Z1tRoUj3i3$S2zIo0T5Pc',#6,'Formal enclosure, environmental and cable qualification','Run approved temperature/humidity/condensation, thermal cycle, vibration/shock/drop, ingress target, fluid/UV where installation requires, pigtail pull/flex, connector/button cycles and membrane/grill adhesion/contamination. Acoustic and RH checks before/after; confirm full-assembly ingress. Long-duration aging beyond this window adds explicit time.','USERDEFINED','7.3',$,$,$,.F.,$,#152,.USERDEFINED.);
#154=IFCTASKTIME('US FCC / Canada ISED host RF, emissions and exposure assessment Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M30D','2026-11-02T09:00:00','2026-12-11T17:00:00','2027-06-14T09:00:00','2027-07-26T17:00:00','2027-06-14T09:00:00','2027-07-26T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#155=IFCTASK('0009O3YS5cqe1vdTxpYcDI',#6,'US FCC / Canada ISED host RF, emissions and exposure assessment','Final configuration tested/assessed against applicable rules and module grant restrictions, radio bands, Wi-Fi/BLE/cellular combinations, antenna/cable changes, RF exposure, host emissions and labels/user notices. Determine whether filings/permissive changes/new certification are needed; obtain written conclusion and reports.','USERDEFINED','7.4',$,$,$,.F.,$,#154,.USERDEFINED.);
#156=IFCTASKTIME('Cellular/operator and conditional NTN acceptance Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M30D','2026-11-02T09:00:00','2026-12-11T17:00:00','2027-06-14T09:00:00','2027-07-26T17:00:00','2027-06-14T09:00:00','2027-07-26T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#157=IFCTASK('12hgaCYUZmBFDvDJ$utkGA',#6,'Cellular/operator and conditional NTN acceptance','Document PTCRB IoT/other applicable route and each selected carrier acceptance; supported module/modem and antenna configuration, OTA RF performance and SIM lifecycle proven. If NTN launches, provider/network approval evidence included; if deferred, disabled-build verification and no launch claim documented.','USERDEFINED','7.5',$,$,$,.F.,$,#156,.USERDEFINED.);
#158=IFCTASKTIME('Complete Bluetooth product qualification Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-06-14T09:00:00','2027-06-25T17:00:00','2027-07-13T09:00:00','2027-07-26T17:00:00','P0Y0M20D','P0Y0M20D',.F.,$,$,$,$,$,$);
#159=IFCTASK('0HvlEo7df_KeQDk6P4Iwo2',#6,'Complete Bluetooth product qualification','Company membership, qualified-design reuse/testing route, product identity and submission complete; retain product qualification record before market distribution.','USERDEFINED','7.6',$,$,$,.F.,$,#158,.USERDEFINED.);
#160=IFCTASKTIME('Battery, transport, material and product safety documentation Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M15D','2026-11-02T09:00:00','2026-11-20T17:00:00','2027-06-14T09:00:00','2027-07-05T17:00:00','2027-07-06T09:00:00','2027-07-26T17:00:00','P0Y0M15D','P0Y0M15D',.F.,$,$,$,$,$,$);
#161=IFCTASK('2RH5JRjEb$8CBFTslLtpOX',#6,'Battery, transport, material and product safety documentation','Confirm actual cell/pack chemistry/configuration and applicable safety evaluation, protection/charging temperature behavior; UN 38.3 test summary for shipped lithium configuration and packaging requirements where applicable, supplier safety files, resin flammability and material declarations. New/modified pack testing requires a separate quoted loop; module approvals do not cover this.','USERDEFINED','7.7',$,$,$,.F.,$,#160,.USERDEFINED.);
#162=IFCTASKTIME('Approve final labels, installation instructions and compliance file Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-07-27T09:00:00','2027-08-10T17:00:00','2027-07-27T09:00:00','2027-08-10T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#163=IFCTASK('0tosQdo_L$xzxGKSM2ODOi',#6,'Approve final labels, installation instructions and compliance file','US/Canada applicable IDs and host labeling, bilingual Canadian notices where required, antenna/install separation and allowed environment/power ratings, approved accessory list, SIM/provider configuration and traceable reports. Assess other markets afresh for expansion.','USERDEFINED','7.8',$,$,$,.F.,$,#162,.USERDEFINED.);
#164=IFCTASKTIME('Visible qualification / lab retest contingency Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-07-27T09:00:00','2027-08-10T17:00:00','2027-07-27T09:00:00','2027-08-10T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#165=IFCTASK('325Bz4_Yuv1gA_A4OaFCUj',#6,'Visible qualification / lab retest contingency','Reserved capacity for one minor corrective/retest cycle. Major hardware, antenna, resin, battery or NTN-route change requires a new estimate; this reserve does not prove an approval.','USERDEFINED','7.9',$,$,$,.F.,$,#164,.USERDEFINED.);
#166=IFCTASKTIME('G6 - Qualification and US/Canada release evidence accepted Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2027-08-10T17:00:00','2027-08-10T17:00:00','2027-08-10T17:00:00','2027-08-10T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#167=IFCTASK('3Rh401QBvpkFmFn6IAsOpy',#6,'G6 - Qualification and US/Canada release evidence accepted','Signed qualification reports and required authorizations/acceptances complete for the exact sale configuration; unresolved deviations closed or formally limited before any customer distribution. NTN inclusion/deferment is explicit.','USERDEFINED','7.10',$,$,$,.T.,$,#166,.USERDEFINED.);
#168=IFCTASKTIME('08 - Manufacturing system and software handoff gates Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M112D','2026-11-02T09:00:00','2026-11-02T17:00:00','2027-03-02T09:00:00','2027-08-10T17:00:00','2027-06-14T09:00:00','2027-08-10T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#169=IFCTASK('1qwJW6okUq2ZZvg6M$7ODH',#6,'08 - Manufacturing system and software handoff gates',$,'USERDEFINED','8',$,$,$,.F.,$,#168,.USERDEFINED.);
#170=IFCTASKTIME('Design production programming and end-of-line fixtures Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-03-02T09:00:00','2027-03-15T17:00:00','2027-06-14T09:00:00','2027-06-25T17:00:00','P0Y0M5D','P0Y0M72D',.F.,$,$,$,$,$,$);
#171=IFCTASK('2bsDae8AoLZBuUdE7vpw_3',#6,'Design production programming and end-of-line fixtures','Fixture design covers protected power, contact access, ESP32 USB/UART and nRF SWD/modem programming, serial/MAC/IMEI/SIM association, rail/current tests, radio/GNSS checks, sensor/mic/RH, buttons/RGB and leak/vent tests where appropriate. Throughput and calibration/reference strategy defined.','USERDEFINED','8.1',$,$,$,.F.,$,#170,.USERDEFINED.);
#172=IFCTASKTIME('Build and correlate fixtures with golden/reference units Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M15D','2026-11-02T07:00:00','2026-11-20T07:00:00','2027-04-12T07:00:00','2027-04-30T07:00:00','2027-07-06T07:00:00','2027-07-26T07:00:00','P0Y0M29D','P0Y0M58D',.F.,$,$,$,$,$,$);
#173=IFCTASK('2LtAEaa9m06NwMOjGmovNL',#6,'Build and correlate fixtures with golden/reference units','Fixtures delivered, limits derived from qualification, reference/failing-unit studies demonstrate detection, gauge repeatability assessed and station/firmware logs retained. Destructive qualification and end-of-line screens have distinct coverage.','USERDEFINED','8.2',$,$,$,.F.,$,#172,.USERDEFINED.);
#174=IFCTASKTIME('External gate - Factory firmware, provisioning and test tools Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T09:00:00','2026-11-27T17:00:00','2027-03-23T09:00:00','2027-04-20T17:00:00','2027-06-28T09:00:00','2027-07-26T17:00:00','P0Y0M37D','P0Y0M67D',.F.,$,$,$,$,$,$);
#175=IFCTASK('0yiAUDRJ1i1sX5$LYkjt81',#6,'External gate - Factory firmware, provisioning and test tools','Versioned manufacturing images, RF test modes, locked test protocols, fixture automation/dashboard diagnostics, protected factory identity flow, authorized provisioning and serial/IMEI/SIM records; pass/fail output schema and calibration persistence. No private keys or credentials in build package/logs.','USERDEFINED','8.3',$,$,$,.F.,$,#174,.USERDEFINED.);
#176=IFCTASKTIME('External gate - Integrated product release candidate Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M30D','2026-11-02T09:00:00','2026-12-11T17:00:00','2027-03-23T09:00:00','2027-05-04T17:00:00','2027-06-28T09:00:00','2027-08-10T17:00:00','P0Y0M67D','P0Y0M67D',.F.,$,$,$,$,$,$);
#177=IFCTASK('34Y35nHvTLEBRIrH77rvhG',#6,'External gate - Integrated product release candidate','Versioned ESP32/nRF/shared/protobuf, mobile tools/onboarding/OTA, dashboard and AWS contracts pass cross-repo integration: cellular/Wi-Fi/BLE paths, location, recording/relay, secure ownership, updates, factory reset/calibration retention, recovery and low power. Feature maturity is not inferred from README. Separate software project manages scope and iterations.','USERDEFINED','8.4',$,$,$,.F.,$,#176,.USERDEFINED.);
#178=IFCTASKTIME('Create assembly SOPs, quality control and training package Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-06-14T09:00:00','2027-06-25T17:00:00','2027-07-27T09:00:00','2027-08-10T17:00:00','P0Y0M30D','P0Y0M30D',.F.,$,$,$,$,$,$);
#179=IFCTASK('3Aw7$bQQpTb8UKj3Gkljhx',#6,'Create assembly SOPs, quality control and training package','Work instructions for membrane cleanliness/bond/cure, grill/screen retention, torque, seals/pigtail/USB, ESD/rework and traceability; incoming/supplier quality, PFMEA/control plan, calibration, first-article approval and operator training. Golden unit and tooling/fixture backups retained.','USERDEFINED','8.5',$,$,$,.F.,$,#178,.USERDEFINED.);
#180=IFCTASKTIME('Approve production material availability and logistics plan Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T07:00:00','2026-11-27T07:00:00','2027-06-14T07:00:00','2027-07-09T07:00:00','2027-07-14T07:00:00','2027-08-10T07:00:00','P0Y0M21D','P0Y0M22D',.F.,$,$,$,$,$,$);
#181=IFCTASK('2Yb_mbjI4xsnTXHQNqVRe0',#6,'Approve production material availability and logistics plan','Approved AVL, alternatives via ECO, allocation and forecast for radios/SIMs/antenna/resin/ePTFE/adhesive/cable/battery; no speculative full MP purchase. Pilot materials authorized; freight/customs/battery transport plan and supplier change notifications defined.','USERDEFINED','8.6',$,$,$,.F.,$,#180,.USERDEFINED.);
#182=IFCTASKTIME('G7 - Controlled pilot build readiness Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2027-08-10T17:00:00','2027-08-10T17:00:00','2027-08-10T17:00:00','2027-08-10T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#183=IFCTASK('1Oq7W3lsiBCNnSfBuSjsAa',#6,'G7 - Controlled pilot build readiness','Released exact hardware/firmware/BOM/work instructions, calibrated validated test stations, material, required compliance evidence and trained operators. Approve proposed PVT lot and quality targets before build.','USERDEFINED','8.7',$,$,$,.T.,$,#182,.USERDEFINED.);
#184=IFCTASKTIME('09 - Pilot, production release and ramp Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M62D','2026-11-02T09:00:00','2026-11-02T17:00:00','2027-08-11T09:00:00','2027-11-08T17:00:00','2027-08-11T09:00:00','2027-11-08T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#185=IFCTASK('2WRnqOK0vCxP$29Hil_ab6',#6,'09 - Pilot, production release and ramp',$,'USERDEFINED','9',$,$,$,.F.,$,#184,.USERDEFINED.);
#186=IFCTASKTIME('Run PVT pilot on intended overseas production line Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T07:00:00','2026-11-13T07:00:00','2027-08-11T07:00:00','2027-08-24T07:00:00','2027-08-11T07:00:00','2027-08-24T07:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#187=IFCTASK('2ao95TBMqiotrnLV0JGIt7',#6,'Run PVT pilot on intended overseas production line','Suggested 100-unit lot uses intended staff, tools, resin/process and end-of-line tests. Record first-pass yield, defects/rework, cycle time, cavity/lot/serial traceability and process capability where sample size supports it; retain golden/reference units.','USERDEFINED','9.1',$,$,$,.F.,$,#186,.USERDEFINED.);
#188=IFCTASKTIME('Ship pilot units and verify receiving / fulfillment process Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T07:00:00','2026-11-06T07:00:00','2027-08-25T07:00:00','2027-08-29T07:00:00','2027-08-25T07:00:00','2027-08-29T07:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#189=IFCTASK('1lwixhZGCChTw00sM6ew1e',#6,'Ship pilot units and verify receiving / fulfillment process','Pilot import, packaging, handling and shipment records verified; random receiving audit matches station records and serial/SIM identities.','USERDEFINED','9.2',$,$,$,.F.,$,#188,.USERDEFINED.);
#190=IFCTASKTIME('Supervised US/Canada vehicle pilot and soak Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M15D','2026-11-02T09:00:00','2026-11-20T17:00:00','2027-08-30T09:00:00','2027-09-20T17:00:00','2027-08-30T09:00:00','2027-09-20T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#191=IFCTASK('0MMWIOzZFrytTWVSyp3YQ$',#6,'Supervised US/Canada vehicle pilot and soak','Representative vehicles/installations and routes exercise cellular/GNSS/Wi-Fi/BLE, power/crank/sleep, heat/condensation, onboarding/OTA/recovery and optional approved NTN; retain logs with consent. Three weeks is a discovery pilot, not lifetime reliability proof.','USERDEFINED','9.3',$,$,$,.F.,$,#190,.USERDEFINED.);
#192=IFCTASKTIME('Close pilot defects and approve yield / quality evidence Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2027-09-21T09:00:00','2027-09-27T17:00:00','2027-09-21T09:00:00','2027-09-27T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#193=IFCTASK('29tgHuLi$RJR84WS0TRYjK',#6,'Close pilot defects and approve yield / quality evidence','Critical/major issues closed with retest and ECO impact assessment; baseline proposed targets >=95% first-pass yield, 100% functional screen pass before ship and zero unresolved critical defects require owner approval. Verify RMA/repair/OTA support and traceability.','USERDEFINED','9.4',$,$,$,.F.,$,#192,.USERDEFINED.);
#194=IFCTASKTIME('G8 - Authorize mass production release Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2027-09-27T17:00:00','2027-09-27T17:00:00','2027-09-27T17:00:00','2027-09-27T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#195=IFCTASK('0o1yH443ZEwcbkuH$c6bSP',#6,'G8 - Authorize mass production release','Operator approves production quantity/PO against demand, cash, capacity and accepted quality. Qualified configuration and golden sample locked; change control, stop-ship and field monitoring owners assigned.','USERDEFINED','9.5',$,$,$,.T.,$,#194,.USERDEFINED.);
#196=IFCTASKTIME('Build first mass-production lot and controlled ramp Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T07:00:00','2026-11-27T07:00:00','2027-09-28T07:00:00','2027-11-01T07:00:00','2027-09-28T07:00:00','2027-11-01T07:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#197=IFCTASK('0IR1NZzHMRCzxQWIC8DWsr',#6,'Build first mass-production lot and controlled ramp','Size of first MP lot set at G8; control plan, sampling/audit, complete serialized test records, yield monitoring and supplier capacity demonstrated; hold nonconforming units.','USERDEFINED','9.6',$,$,$,.F.,$,#196,.USERDEFINED.);
#198=IFCTASKTIME('First MP lot outgoing audit and shipment release Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2027-11-02T09:00:00','2027-11-08T17:00:00','2027-11-02T09:00:00','2027-11-08T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#199=IFCTASK('1vF_amC1FztQilDrqEvo2T',#6,'First MP lot outgoing audit and shipment release','Outgoing functional/visual/packaging audit and documentation pass, approved labels/manuals/certification configuration checked; ship only released units with traceability and support readiness.','USERDEFINED','9.7',$,$,$,.F.,$,#198,.USERDEFINED.);
#200=IFCTASKTIME('G9 - First mass-production lot ready to ship Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M0D','2026-11-02T17:00:00','2026-11-02T17:00:00','2027-11-08T17:00:00','2027-11-08T17:00:00','2027-11-08T17:00:00','2027-11-08T17:00:00','P0Y0M0D','P0Y0M0D',.T.,$,$,$,$,$,$);
#201=IFCTASK('2uW21quY4mFzpnM9uTrfDa',#6,'G9 - First mass-production lot ready to ship','First MP lot accepted and released for shipment; subsequent ramp managed by yield, demand and field performance. Freight to customer is outside this ready-to-ship milestone.','USERDEFINED','9.8',$,$,$,.T.,$,#200,.USERDEFINED.);

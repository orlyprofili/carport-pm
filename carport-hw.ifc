#87=IFCTASK('1AdUst$aLkF2Hg8FSNrBih',#6,'Rev1 power, input fault screening and radio transient tests','Measure reverse/positive stress within declared envelope, brownout and crank recovery, USB-only/battery absent/depleted modes, charge/source limits after reset, 3.2 V radio droop, thermal/efficiency and sleep draw; no unresolved unsafe stress. Destructive tests use allocated units.','USERDEFINED','3.5',$,$,$,.F.,$,#86,.USERDEFINED.);
#88=IFCTASKTIME('Rev1 antenna, coexistence and EMC pre-scan Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-01-18T09:00:00','2027-01-29T17:00:00','2027-01-19T09:00:00','2027-02-01T17:00:00','P0Y0M0D','P0Y0M1D',.F.,$,$,$,$,$,$);
#89=IFCTASK('2bmd4xNojqAxS4UDekk5jg',#6,'Rev1 antenna, coexistence and EMC pre-scan','In representative enclosure/cabling, assess BLE/Wi-Fi/cellular transmit and GNSS receive sensitivity/TTFF, coexistence/desense and switcher noise; bench/conducted checks plus radiated pre-scan; antenna candidates, retuning needs and lab modes documented.','USERDEFINED','3.6',$,$,$,.F.,$,#88,.USERDEFINED.);
#90=IFCTASKTIME('Rev1 integrated membrane, housing and sensor experiments Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2027-01-18T09:00:00','2027-01-29T17:00:00','2027-01-19T09:00:00','2027-02-01T17:00:00','P0Y0M0D','P0Y0M1D',.F.,$,$,$,$,$,$);
#91=IFCTASK('1_OEMXiCJEbfLgV8hADEik',#6,'Rev1 integrated membrane, housing and sensor experiments','RH step response/hysteresis, thermal self-heating, acoustic response/noise, condensation/ingress screening and cable pull/bend. Confirm antenna placement, button feel/light visibility and development button access on actual assembly.','USERDEFINED','3.7',$,$,$,.F.,$,#90,.USERDEFINED.);

#1431=IFCRELDEFINESBYPROPERTIES('0NuHi5DWVwmQ9PdTixsx8C',#6,$,$,(#169),#1430);
#1432=IFCPROPERTYSINGLEVALUE('Notes',$,IFCTEXT('[{"id":"REGDOC-exit","text":"Exit: Prepare applicable US/Canada IDs/labels and Canadian bilingual notices as required, antenna/install separation, approved operating environment/power/accessories and provider scope. Reference Rev2/T1 reports and update to final T2 after delta/retest; final document approval occurs at G6. Expansion markets require fresh assessment.","done":false}]'),$);
#1433=IFCPROPERTYSET('2TKreUh4pZadvYQ3HdGJIO',#6,'OPS_TaskNotes',$,(#1432));
#1434=IFCRELDEFINESBYPROPERTIES('2RGl6YigV1qnbdbtdhQ7cE',#6,$,$,(#171),#1433);
#1435=IFCPROPERTYSINGLEVALUE('Notes',$,IFCTEXT('[{"id":"RETESTBUF-exit","text":"Exit: Reserve one minor affected-test/retest campaign and lab confirmation for final T2, including report/filing/operator acceptance and documentation updates. Lab-approved equivalence may reduce consumed reserve; no blanket acceptance of substitute housings/materials. Major hardware/antenna/resin/battery/NTN changes require an explicit longer loop; all affected tests must close before G6.","done":false}]'),$);
#1436=IFCPROPERTYSET('0DHeGxwOFgchZzFHYHRqs7',#6,'OPS_TaskNotes',$,(#1435));
#1437=IFCRELDEFINESBYPROPERTIES('3bVWcUR7QM0gKeHzc_UrVf',#6,$,$,(#173),#1436);
#1438=IFCPROPERTYSINGLEVALUE('Notes',$,IFCTEXT('[{"id":"MARKET-exit","text":"Exit: Signed qualification reports and required authorizations/acceptances cover the exact final T2 sale configuration. T2 delta disposition and affected retests closed, final labels/manuals approved, and NTN inclusion/deferment explicit before customer distribution. Earlier Rev2/T1 results are carried forward only with documented lab/quality agreement.","done":false}]'),$);

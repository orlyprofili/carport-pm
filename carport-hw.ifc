#1405=IFCPROPERTYSINGLEVALUE('Notes',$,IFCTEXT('[{"id":"QUALPOWER-exit","text":"Exit: Run signed ISO 7637-2 / ISO 16750-2 electrical tests as scoped, reverse battery, crank, jump start, load dump, hot plug, shorts and USB/source combinations on traceable Rev2 with representative harness/pack/load and firmware. Printed housing is acceptable only where the lab records that enclosure/thermal/mounting effects cannot invalidate results. Board/port ESD may start; final accessible-assembly ESD is a separate T1 task. Verify recovery/leakage; no blanket automotive-certified claim.","done":false}]'),$);
#1406=IFCPROPERTYSET('0WME9bAEjTl2ig8RG5x7D7',#6,'OPS_TaskNotes',$,(#1405));
#1407=IFCRELDEFINESBYPROPERTIES('1A9SMLuw27a7hdezmC7vrY',#6,$,$,(#153),#1406);
#1408=IFCPROPERTYSINGLEVALUE('Notes',$,IFCTEXT('[{"id":"QUALASSEMBLY-exit","text":"Exit: Complete enclosure-dependent accessible-point ESD, USB/pigtail/button/seam discharge paths and worst-case enclosed thermal/radio-load checks on representative T1. Cross-reference early Rev2 power results; repeat affected tests where T1 grounding, mounting, heat flow or wiring differs. Final T2 changes require delta review.","done":false}]'),$);

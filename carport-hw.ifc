#41=IFCTASK('0Yt91W3_XuyENWT1uVx_pi',#6,'Planning start - Rev0 complete; Rev1 schematic in review and layout underway','Status supplied 2026-10-31. Historical completion dates and percent complete are unknown; this is a planning anchor, not the actual Rev0 completion date.','USERDEFINED','1.1',$,$,$,.T.,$,#40,.USERDEFINED.);
#42=IFCTASKTIME('Confirm US/Canada launch requirements and installation envelope Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2026-11-02T09:00:00','2026-11-06T17:00:00','2026-11-20T09:00:00','2026-11-26T17:00:00','P0Y0M0D','P0Y0M14D',.F.,$,$,$,$,$,$);
#43=IFCTASK('2yiUDou6FUWp1sRifNAmx7',#6,'Confirm US/Canada launch requirements and installation envelope','Approved requirements: intended install location; 12 V baseline versus 24 V requirement; temperature, humidity, ingress, acoustic, GNSS, antenna, vehicle mounting, safe behavior and operating/survival power envelope. US + Canada launch confirmed; other markets are later change-controlled scope.','USERDEFINED','1.2',$,$,$,.F.,$,#42,.USERDEFINED.);
#44=IFCTASKTIME('Agree certification and qualification matrix with accredited lab Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-09T09:00:00','2026-11-20T17:00:00','2026-11-27T09:00:00','2026-12-10T17:00:00','P0Y0M0D','P0Y0M14D',.F.,$,$,$,$,$,$);
#45=IFCTASK('3X81hdGJpx3Bgli5nybuZz',#6,'Agree certification and qualification matrix with accredited lab','Written US FCC / Canada ISED route, exact ESP32 and nRF module grants/integration conditions, antennas and gains, RF exposure/use distance and simultaneous transmit cases; host emissions, GNSS receive performance, cellular/operator and Bluetooth qualification scope. Evaluate safety/battery/shipping and vehicle approval applicability. Lab quote, sample counts, modes and slot strategy recorded. Agree which electrical, conducted RF, network/protocol and documentation results may be accepted from Rev2 in printed housings; identify enclosure-sensitive tests, representative T1 sample requirements and T2 delta/retest rules.','USERDEFINED','1.3',$,$,$,.F.,$,#44,.USERDEFINED.);
#46=IFCTASKTIME('Select overseas build partners and reserve indicative capacity Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M10D','2026-11-02T09:00:00','2026-11-13T17:00:00','2026-11-09T09:00:00','2026-11-20T17:00:00','2026-11-27T09:00:00','2026-12-10T17:00:00','P0Y0M0D','P0Y0M14D',.F.,$,$,$,$,$,$);
#47=IFCTASK('0jKrb0BkVKqAlX6e0t$lXt',#6,'Select overseas build partners and reserve indicative capacity','PCBA, mold/assembly and membrane/cable vendors shortlisted; quotes, Incoterms, import responsibility, tooling ownership, payment/release gates, English controlled drawings, weekly overlap meeting and change approval process. Lead times remain estimates until supplier commits. Confirm actual holidays/country.','USERDEFINED','1.4',$,$,$,.F.,$,#46,.USERDEFINED.);
#48=IFCTASKTIME('Approve sample allocation and destructive-test budgets Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M5D','2026-11-02T09:00:00','2026-11-06T17:00:00','2026-11-23T09:00:00','2026-11-27T17:00:00','2026-12-11T09:00:00','2026-12-17T17:00:00','P0Y0M0D','P0Y0M14D',.F.,$,$,$,$,$,$);
#49=IFCTASK('1uqCh1BeFt8YJSUpI8vpby',#6,'Approve sample allocation and destructive-test budgets','Allocate serialized boards/housings by test; suggested Rev1 15 boards, Rev2 30 boards, T1 20 sets, T2 60 sets, PVT 100 units subject to lab needs, destructive tests, spares, budget and demand. Counts are proposals, not purchase authorizations. Allocate separate early Rev2 electrical/conducted test units, T1 chamber/RF units, destructive-test spares and retained reference samples so parallel tracks do not share unavailable hardware.','USERDEFINED','1.5',$,$,$,.F.,$,#48,.USERDEFINED.);
#50=IFCTASKTIME('Evaluate physical SIM / eUICC provider and roaming Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M15D','2026-11-02T09:00:00','2026-11-20T17:00:00','2026-11-09T09:00:00','2026-11-27T17:00:00','2027-01-08T09:00:00','2027-01-28T17:00:00','P0Y0M30D','P0Y0M37D',.F.,$,$,$,$,$,$);
#51=IFCTASK('3R0a$GwvzG_9uS4nrrEHJQ',#6,'Evaluate physical SIM / eUICC provider and roaming','Provider comparison covers US/Canada LTE-M/NB-IoT coverage, roaming/permanent roaming, PSM/eDRX, APN, activation, provisioning, supply/form factor, profile lifecycle, cost and operator approvals. Bench attach evidence and fallback physical SIM choice. Do not assume eSIM is merely a socket substitution.','USERDEFINED','1.6',$,$,$,.F.,$,#50,.USERDEFINED.);
#52=IFCTASKTIME('Evaluate nRF9151 satellite service and supported hardware/firmware Time',.PREDICTED.,$,.WORKTIME.,'P0Y0M20D','2026-11-02T09:00:00','2026-11-27T17:00:00','2026-11-09T09:00:00','2026-12-04T17:00:00','2026-12-23T09:00:00','2027-01-28T17:00:00','P0Y0M25D','P0Y0M32D',.F.,$,$,$,$,$,$);
#53=IFCTASK('13diFvLhmDolRhenNhCisM',#6,'Evaluate nRF9151 satellite service and supported hardware/firmware','Check actual nRF9151 build code, compatible NTN modem/NCS release, provider service/bands/coverage, antenna/sky view, TN/NTN transitions, SIM profile, power budget, test access and approval route. Record working eval evidence or remaining gaps; not yet a launch promise.','USERDEFINED','1.7',$,$,$,.F.,$,#52,.USERDEFINED.);

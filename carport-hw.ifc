#1441=IFCPROPERTYSINGLEVALUE('Notes',$,IFCTEXT('[{"id":"FIXDES-exit","text":"Exit: Fixture design covers protected power, contact access, ESP32 USB/UART and nRF SWD/modem programming, serial/MAC/IMEI/SIM association, rail/current tests, radio/GNSS checks, sensor/mic/RH, buttons/RGB and leak/vent tests where appropriate. Throughput and calibration/reference strategy defined.","done":false}]'),$);
